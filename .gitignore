node_modules/
.DS_Store

# Every env file is secret by default; the template is the one exception. Listing
# .env and .env.local individually let a .env.production or .env.staging through.
.env
.env.*
!.env.example

# Runtime state and generated media.
data/videos/
data/media/index.json
data/media/screenshots/
data/media/recordings/
data/media/uploads/
data/knowledge/sources.json
# Per-thread research trails: runtime state, and page text we did not write. Same for the
# shelf built out of them — every figure in it is a sentence off someone else's page.
data/research/
data/knowledge/source-library.json
data/capture/
data/brand/tokens.css
out/
.auth/
