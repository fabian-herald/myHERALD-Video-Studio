    "@google/genai": "^2.13.0",
    "gsap": "^3.13.0",
    "hyperframes": "^0.7.77",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
