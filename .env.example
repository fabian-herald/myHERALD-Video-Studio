# Copy to .env.local. Never commit the real values.

# Narration. Required for the local Tier-A pipeline.
GEMINI_API_KEY=your_gemini_api_key

# Word timings for the narration take. Required: Gemini returns audio and nothing else,
# and the plan is retimed from where each phrase actually falls. whisper-large-v3-turbo,
# multilingual, about a tenth of a cent per video.
GROQ_API_KEY=your_groq_api_key

# Composer adapters. Both authenticate through their own CLI subscription,
# so no API key is needed for either — only a resolvable executable.
# `claude` is found on PATH by default; set this only if it lives elsewhere.
# CLAUDE_CLI_PATH=/Users/you/.local/bin/claude
# `codex` is usually NOT on PATH even when the app is installed.
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex

# HyperFrames needs Node 22+. Set this when the default `node` is older
# (nvm defaults often are); /usr/local/bin/node is probed automatically.
# HYPERFRAMES_NODE_PATH=/usr/local/bin/node

# Screenshot capture. The workspace is pinned on every navigation and capture
# refuses to run against the live app without one.
CAPTURE_BASE_URL=http://localhost:3000
CAPTURE_WORKSPACE_ID=

# Optional providers (milestone 5).
# Studio preferences live in data/settings.json (content language, composer) and are
# edited in the UI, not here.

# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=
